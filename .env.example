# Relative paths are resolved from the metadata-editor project root.
MEDIA_LIBRARY_ROOT=../demo-media

# The API remains bound to 127.0.0.1.
METADATA_EDITOR_PORT=4174

# Optional embedded Hiplingo preview origin. The default is the Hiplingo
# Vite development server at http://127.0.0.1:5173.
VITE_HIPLINGO_PREVIEW_ORIGIN=http://127.0.0.1:5173

# Read-only production origin used by the Hiplingo preview split comparison.
VITE_HIPLINGO_PUBLIC_ORIGIN=https://hiplingo.com
