{
  "name": "metadata-editor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "validate:library": "tsx scripts/validate-library.ts",
    "validate:release": "tsx scripts/validate-library.ts --release",
    "migrate:artists": "tsx scripts/migrate-artists.ts",
    "publish:plan": "tsx scripts/plan-publish.ts",
    "preflight:publish": "tsx scripts/plan-publish.ts --strict",
    "plan:unpublish-release": "tsx scripts/plan-public-release-unpublish.ts",
    "unpublish:release": "tsx scripts/unpublish-public-release.ts",
    "preview": "vite preview",
    "tags:generate": "scripts/player-tag-tests/generate-fixtures.sh",
    "tags:summarize": "scripts/player-tag-tests/summarize-probes.py",
    "audit:file-spec": "tsx scripts/audit-media-file-spec.ts",
    "audit:media-technical": "tsx scripts/audit-media-technical.ts",
    "repair:ingest-receipt-release-prefix": "tsx scripts/repair-ingest-receipt-release-prefix.ts",
    "verify:published-media": "tsx scripts/verify-published-media.ts",
    "manifest:published-media": "tsx scripts/write-published-media-deployment-manifest.ts",
    "stage:published-media": "tsx scripts/stage-published-media.ts",
    "plan:published-media-deploy": "tsx scripts/plan-published-media-deployment.ts",
    "deploy:published-media": "tsx scripts/deploy-published-media.ts",
    "rollback:published-media": "tsx scripts/rollback-published-media.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "smol-toml": "^1.7.0",
    "vite": "^8.1.4",
    "@hiplingo/media-player": "file:../packages/media-player",
    "@hiplingo/brand": "file:../packages/brand"
  },
  "devDependencies": {
    "@types/node": "^24.10.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
